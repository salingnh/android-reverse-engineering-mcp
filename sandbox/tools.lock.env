# Tool versions used by the sandbox image. Runtime never resolves "latest".
JADX_VERSION=1.5.5
VINEFLOWER_VERSION=1.12.0

# Optional SHA-256 values can be passed as Docker build args:
#   --build-arg JADX_SHA256=<sha256>
#   --build-arg VINEFLOWER_SHA256=<sha256>
# Keep them in CI/repository variables once independently verified.
