# Tool versions used by the sandbox image. Runtime never resolves "latest".
JADX_VERSION=1.5.6
JADX_SHA256=545ea2be9c242511bc145755cf4bda2485ade42966e096f8b4d3da2a230e8974
VINEFLOWER_VERSION=1.12.0

# Vineflower remains version-pinned. Record an independently verified digest
# here before treating its release artifact as fully hash-pinned.
VINEFLOWER_SHA256=

# Semantic DEX/XREF/CFG backend. The top-level Androguard wheel is pinned and
# SHA-256 verified. Runtime dependencies are resolved into /opt/python-site,
# their exact installed versions are recorded in installed-requirements.txt,
# and CI must execute a real DEX XREF/CFG test inside the final image. A future
# supply-chain hardening phase should hash-lock every transitive wheel as well.
ANDROGUARD_VERSION=4.1.4
ANDROGUARD_WHEEL_SHA256=6265a6d4007401cf5a62a98fa99a1c2994644d4311da031a5398efe3bcaa63b0
