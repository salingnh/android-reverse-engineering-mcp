{
  "mcpServers": {
    "safe-android-reverser": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/safe-reverser-mcp",
      "args": [],
      "env": {
        "SAFE_REVERSER_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "SAFE_REVERSER_DATA_DIR": "${CLAUDE_PLUGIN_DATA}",
        "SAFE_REVERSER_IMAGE": "${SAFE_REVERSER_IMAGE:-ghcr.io/salingnh/safe-android-reverser:0.1.0}",
        "SAFE_REVERSER_RUNTIME": "${SAFE_REVERSER_RUNTIME:-auto}",
        "SAFE_REVERSER_AUTO_PULL": "${SAFE_REVERSER_AUTO_PULL:-0}"
      }
    }
  }
}
