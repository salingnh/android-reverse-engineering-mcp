        "source":{"type":"object","properties":{"kind":{"type":"string","enum":["parameter","return","field","node"]},"index":{"type":"integer","minimum":0,"maximum":1024},"name":{"type":"string","minLength":1,"maxLength":512},"node_id":{"type":"string","minLength":1,"maxLength":256}},"required":["kind"],"additionalProperties":false},
        "sink":{"type":"object","properties":{"kind":{"type":"string","enum":["parameter","return","field","node"]},"index":{"type":"integer","minimum":0,"maximum":1024},"name":{"type":"string","minLength":1,"maxLength":512},"node_id":{"type":"string","minLength":1,"maxLength":256}},"required":["kind"],"additionalProperties":false},
        "method_limit":{"type":"integer","minimum":1,"maximum":32,"default":12},
        "analysis_depth":{"type":"integer","minimum":0,"maximum":8,"default":3},
        "instruction_limit":{"type":"integer","minimum":1,"maximum":20000,"default":8000},
        "path_depth":{"type":"integer","minimum":1,"maximum":32,"default":12},
