  {
    "name": "get_application_map",
    "description": "Return a deterministic bounded Application Map projection over the canonical Program Model for one analyzed representation.",
    "inputSchema": {
      "type":"object",
      "properties": {
        "job_id":{"type":"string","pattern":"^[0-9a-f]{12}$"},
        "representation":{"type":"string","enum":["dex","flutter-dart-aot"]},
        "ownership_scope":{"type":"string","enum":["application","all","first_party","third_party","platform","generated","unknown"],"default":"application"},
        "node_limit":{"type":"integer","minimum":1,"maximum":80,"default":40},
        "edge_limit":{"type":"integer","minimum":1,"maximum":200,"default":100}
      },
      "required":["job_id","representation"],"additionalProperties":false
    }
  },
  {
    "name": "expand_application_node",
    "description": "Re-resolve and progressively expand one canonical Program Model entity from an Application Map without relying on prior process state.",
    "inputSchema": {
      "type":"object",
      "properties": {
        "job_id":{"type":"string","pattern":"^[0-9a-f]{12}$"},
        "representation":{"type":"string","enum":["dex","flutter-dart-aot"]},
        "entity_id":{"type":"string","maxLength":256},
        "ownership_scope":{"type":"string","enum":["application","all","first_party","third_party","platform","generated","unknown"],"default":"application"},
        "direction":{"type":"string","enum":["incoming","outgoing","both"],"default":"both"},
        "relationship_kinds":{"type":"array","items":{"type":"string","maxLength":128},"maxItems":32},
        "node_limit":{"type":"integer","minimum":2,"maximum":80,"default":40},
        "edge_limit":{"type":"integer","minimum":1,"maximum":200,"default":100},
        "cursor":{"type":"string","maxLength":4096}
      },
      "required":["job_id","representation","entity_id"],"additionalProperties":false
    }
  },
  {
    "name": "get_function_context",
    "description": "Return bounded progressive semantic context for one canonical function, including structural topology, provenance, and a safe localized source slice when available.",
    "inputSchema": {
      "type":"object",
      "properties": {
        "job_id":{"type":"string","pattern":"^[0-9a-f]{12}$"},
        "representation":{"type":"string","enum":["dex","flutter-dart-aot"]},
        "entity_id":{"type":"string","minLength":1,"maxLength":256},
        "ownership_scope":{"type":"string","enum":["application","all","first_party","third_party","platform","generated","unknown"],"default":"application"},
        "direction":{"type":"string","enum":["incoming","outgoing","both"],"default":"both"},
        "relationship_kinds":{"type":"array","items":{"type":"string","enum":["DECLARES","CALLS","XREF","CALLS_EXTERNAL","READS","WRITES","PASSES_ARGUMENT","RETURNS","TRANSFORMS","FLOWS_TO","SANITIZES","BINDS_TO_NATIVE","CONFIRMS","CONTRADICTS"]},"maxItems":32},
        "relationship_limit":{"type":"integer","minimum":1,"maximum":120,"default":32},
        "evidence_limit":{"type":"integer","minimum":1,"maximum":32,"default":12},
        "source_line_limit":{"type":"integer","minimum":1,"maximum":400,"default":120},
        "source_byte_limit":{"type":"integer","minimum":1024,"maximum":65536,"default":16384},
        "response_budget_bytes":{"type":"integer","minimum":32768,"maximum":262144,"default":65536},
        "cursor":{"type":"string","maxLength":4096}
      },
      "required":["job_id","representation","entity_id"],"additionalProperties":false
    }
  },
  {
    "name": "trace_value",
    "description": "Trace a semantic value through bounded proven data-flow evidence from one canonical DEX function; structural CALLS/XREF topology is never treated as value flow.",
    "inputSchema": {
      "type":"object",
      "properties": {
        "job_id":{"type":"string","pattern":"^[0-9a-f]{12}$"},
        "representation":{"type":"string","enum":["dex"]},
        "entity_id":{"type":"string","minLength":1,"maxLength":256},
        "seed":{"type":"object","properties":{"kind":{"type":"string","enum":["parameter","return","field","node"]},"index":{"type":"integer","minimum":0,"maximum":1024},"name":{"type":"string","minLength":1,"maxLength":512},"node_id":{"type":"string","minLength":1,"maxLength":256}},"required":["kind"],"additionalProperties":false},
        "direction":{"type":"string","enum":["forward","backward","both"],"default":"both"},
        "method_limit":{"type":"integer","minimum":1,"maximum":32,"default":12},
        "analysis_depth":{"type":"integer","minimum":0,"maximum":8,"default":3},
        "instruction_limit":{"type":"integer","minimum":1,"maximum":20000,"default":8000},
        "trace_depth":{"type":"integer","minimum":0,"maximum":32,"default":8},
        "node_limit":{"type":"integer","minimum":1,"maximum":500,"default":160}
      },
      "required":["job_id","representation","entity_id","seed"],"additionalProperties":false
    }
  },
  {
    "name": "find_source_to_sink",
