      },
      "required": ["job_id", "representation", "entity_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_function_context",
    "description": "Return bounded progressive semantic context for one canonical function, including structural topology, provenance, and a safe localized source slice when available.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
        "representation": {"type": "string", "enum": ["dex", "flutter-dart-aot"]},
        "entity_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "ownership_scope": {"type": "string", "enum": ["application", "all", "first_party", "third_party", "platform", "generated", "unknown"], "default": "application"},
        "direction": {"type": "string", "enum": ["incoming", "outgoing", "both"], "default": "both"},
        "relationship_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["DECLARES", "CALLS", "XREF", "CALLS_EXTERNAL", "READS", "WRITES", "PASSES_ARGUMENT", "RETURNS", "TRANSFORMS", "FLOWS_TO", "SANITIZES", "BINDS_TO_NATIVE", "CONFIRMS", "CONTRADICTS"]
          },
          "maxItems": 32
        },
        "relationship_limit": {"type": "integer", "minimum": 1, "maximum": 120, "default": 32},
        "evidence_limit": {"type": "integer", "minimum": 1, "maximum": 32, "default": 12},
        "source_line_limit": {"type": "integer", "minimum": 1, "maximum": 400, "default": 120},
        "source_byte_limit": {"type": "integer", "minimum": 1024, "maximum": 65536, "default": 16384},
        "response_budget_bytes": {"type": "integer", "minimum": 32768, "maximum": 262144, "default": 65536},
        "cursor": {"type": "string", "maxLength": 4096}
      },
      "required": ["job_id", "representation", "entity_id"],
      "additionalProperties": false
    }
  }
