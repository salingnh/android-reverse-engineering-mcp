#!/usr/bin/env bash
set -euo pipefail
umask 077

fail() { printf 'safe-android-reverser: %s\n' "$*" >&2; exit 1; }

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
VERSION_FILE="$PLUGIN_ROOT/VERSION"
[[ -r "$VERSION_FILE" ]] || fail "missing plugin VERSION file: $VERSION_FILE"
VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid plugin version: $VERSION"

command -v python3 >/dev/null 2>&1 || fail "python3 is required for the Safe Reverser control plane"

RUNTIME="${SAFE_REVERSER_RUNTIME:-auto}"
PROJECT_DIR="${SAFE_REVERSER_PROJECT_DIR:-${CLAUDE_PROJECT_DIR:-$PWD}}"
DATA_DIR="${SAFE_REVERSER_DATA_DIR:-${CLAUDE_PLUGIN_DATA:-$HOME/.local/share/safe-android-reverser}}"

choose_runtime() {
  if [[ "$RUNTIME" != "auto" ]]; then
    [[ "$RUNTIME" == "podman" || "$RUNTIME" == "docker" ]] || fail "runtime must be podman, docker, or auto"
    command -v "$RUNTIME" >/dev/null 2>&1 || fail "configured runtime '$RUNTIME' not found"
    printf '%s' "$RUNTIME"
    return
  fi
  if command -v podman >/dev/null 2>&1; then
    printf 'podman'
  elif command -v docker >/dev/null 2>&1; then
    printf 'docker'
  else
    fail "Podman or Docker is required. Rootless Podman is recommended."
  fi
}

RUNTIME="$(choose_runtime)"
[[ -d "$PROJECT_DIR" ]] || fail "project directory not found: $PROJECT_DIR"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"

if [[ -L "$DATA_DIR" ]]; then
  fail "plugin data directory must not be a symlink: $DATA_DIR"
fi
mkdir -p "$DATA_DIR" || fail "cannot create data directory: $DATA_DIR"
[[ -L "$DATA_DIR" ]] && fail "plugin data directory must not be a symlink: $DATA_DIR"
DATA_DIR="$(cd "$DATA_DIR" && pwd -P)"
[[ -w "$DATA_DIR" ]] || fail "plugin data directory is not writable: $DATA_DIR"

export SAFE_REVERSER_PLUGIN_VERSION="$VERSION"
export SAFE_REVERSER_RUNTIME="$RUNTIME"
export SAFE_REVERSER_PROJECT_DIR="$PROJECT_DIR"
export SAFE_REVERSER_DATA_DIR="$DATA_DIR"

exec python3 "$PLUGIN_ROOT/bin/mcp-control-plane.py"
