#!/usr/bin/env bash
set -euo pipefail

IMAGE="${SAFE_REVERSER_IMAGE:-ghcr.io/salingnh/safe-android-reverser:0.2.0}"
RUNTIME="${SAFE_REVERSER_RUNTIME:-auto}"
PROJECT_DIR="${SAFE_REVERSER_PROJECT_DIR:-${CLAUDE_PROJECT_DIR:-$PWD}}"
DATA_DIR="${SAFE_REVERSER_DATA_DIR:-${CLAUDE_PLUGIN_DATA:-$HOME/.local/share/safe-android-reverser}}"
MEMORY="${SAFE_REVERSER_MEMORY:-4g}"
CPUS="${SAFE_REVERSER_CPUS:-2}"
PIDS="${SAFE_REVERSER_PIDS_LIMIT:-256}"
AUTO_PULL="${SAFE_REVERSER_AUTO_PULL:-1}"

fail() { printf 'safe-android-reverser: %s\n' "$*" >&2; exit 1; }
info() { printf 'safe-android-reverser: %s\n' "$*" >&2; }

choose_runtime() {
  if [[ "$RUNTIME" != "auto" ]]; then
    command -v "$RUNTIME" >/dev/null 2>&1 || fail "configured runtime '$RUNTIME' not found"
    printf '%s' "$RUNTIME"
    return
  fi
  if command -v podman >/dev/null 2>&1; then
    printf 'podman'
  elif command -v docker >/dev/null 2>&1; then
    printf 'docker'
  else
    fail "Podman or Docker is required. Rootless Podman is recommended."
  fi
}

RUNTIME="$(choose_runtime)"
[[ -d "$PROJECT_DIR" ]] || fail "project directory not found: $PROJECT_DIR"
mkdir -p "$DATA_DIR"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
DATA_DIR="$(cd "$DATA_DIR" && pwd -P)"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

if ! "$RUNTIME" image inspect "$IMAGE" >/dev/null 2>&1; then
  if [[ "$AUTO_PULL" != "1" ]]; then
    fail "sandbox image is not installed: $IMAGE. Pull it with '$RUNTIME pull $IMAGE' or allow automatic pull with SAFE_REVERSER_AUTO_PULL=1."
  fi
  info "sandbox image not found locally; pulling $IMAGE with $RUNTIME (first start only)"
  if ! "$RUNTIME" pull "$IMAGE" >&2; then
    fail "failed to pull sandbox image: $IMAGE"
  fi
  "$RUNTIME" image inspect "$IMAGE" >/dev/null 2>&1 || fail "sandbox image is still unavailable after pull: $IMAGE"
fi

COMMON=(
  run --rm --interactive
  --network=none
  --read-only
  --cap-drop=ALL
  --security-opt=no-new-privileges
  --pids-limit="$PIDS"
  --memory="$MEMORY"
  --cpus="$CPUS"
  --tmpfs=/tmp:rw,nosuid,nodev,size=1g
  --tmpfs=/work:rw,nosuid,nodev,size=2g
)

if [[ "$RUNTIME" == "podman" ]]; then
  exec podman "${COMMON[@]}" \
    --userns=keep-id \
    --user="$HOST_UID:$HOST_GID" \
    --volume="$PROJECT_DIR:/workspace:ro,z" \
    --volume="$DATA_DIR:/data:rw,z" \
    "$IMAGE"
else
  exec docker "${COMMON[@]}" \
    --user="$HOST_UID:$HOST_GID" \
    --volume="$PROJECT_DIR:/workspace:ro" \
    --volume="$DATA_DIR:/data:rw" \
    "$IMAGE"
fi
